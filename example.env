# podcast-digest configuration. Copy to `.env` (git-ignored) and fill in.
# Every setting with its default is described in README.md.

# --- Mail (required) -----------------------------------------------------
PODCAST_DIGEST_MAIL_FROM=digest@example.com
# Any SMTP server. 587 + starttls is the common case; 465 + ssl also works.
PODCAST_DIGEST_SMTP_HOST=smtp.example.com
PODCAST_DIGEST_SMTP_PORT=587
PODCAST_DIGEST_SMTP_SECURITY=starttls
PODCAST_DIGEST_SMTP_USERNAME=digest@example.com
PODCAST_DIGEST_SMTP_PASSWORD=
# Or Microsoft 365 via the Graph API (app registration with Mail.Send):
# PODCAST_DIGEST_MAILER=graph
# PODCAST_DIGEST_GRAPH_TENANT_ID=
# PODCAST_DIGEST_GRAPH_CLIENT_ID=
# PODCAST_DIGEST_GRAPH_CLIENT_SECRET=

# --- Summarizer (pick one) -----------------------------------------------
# a) A model API (default). claude-* uses Anthropic; other names use OpenAI.
#    claude-sonnet-5-5 is cheaper than the default claude-opus-5-5.
PODCAST_DIGEST_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# A local or self-hosted OpenAI-compatible server (Ollama, LM Studio, vLLM):
# PODCAST_DIGEST_MODEL=llama3.1:8b
# PODCAST_DIGEST_OPENAI_BASE_URL=http://host.docker.internal:11434/v1  # Ollama on the Docker host

# b) A command per LLM call, prompt on stdin, answer on stdout:
# PODCAST_DIGEST_SUMMARIZER=command
# PODCAST_DIGEST_COMMAND=claude -p
# ...optionally run on another machine over SSH:
# PODCAST_DIGEST_SSH_HOST=gpu-box.example.com
# PODCAST_DIGEST_SSH_USER=me
# PODCAST_DIGEST_SSH_KEY_B64=        # base64 of the private key (or mount it)

# Summary style: general (default) or finance. Or your own prompt file:
# PODCAST_DIGEST_SUMMARY_STYLE=general
# PODCAST_DIGEST_SUMMARY_PROMPT_FILE=/config/prompt.txt

# Attach the transcript: none (default), raw, or cleaned (LLM-cleaned Markdown).
# PODCAST_DIGEST_ATTACH_TRANSCRIPT=cleaned

# --- Transcription -------------------------------------------------------
# Feeds that link their own transcript (Podcasting 2.0) skip local transcription.
# PODCAST_DIGEST_PUBLISHER_TRANSCRIPTS=true
# Whisper models fetched on first start; add large-v3-turbo for non-English feeds.
# PODCAST_DIGEST_WHISPER_MODELS=medium.en large-v3-turbo
# PODCAST_DIGEST_WHISPER_THREADS=8

# --- Optional ------------------------------------------------------------
# POST every emailed episode (metadata, summary, transcript) as JSON:
# PODCAST_DIGEST_WEBHOOK_URL=https://example.com/hooks/podcasts
# PODCAST_DIGEST_WEBHOOK_TOKEN=
# Ping a dead-man's switch after each healthy tick:
# PODCAST_DIGEST_HEARTBEAT_URL=https://hc-ping.example.com/your-check
# MCP server (compose profile "mcp"): the bearer token clients send, and the
# user it runs as (must be able to write config/feeds.toml).
# PODCAST_MCP_BEARER_TOKEN=
# PUID=1000
# PGID=1000
